<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ExampleApp"
             xmlns:mvvm="clr-namespace:SingleFinite.Mvvm.Blazor;assembly=SingleFinite.Mvvm.Blazor"
             x:Class="ExampleApp.MainPage">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type mvvm:ViewComponentRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
